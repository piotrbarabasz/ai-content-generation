# Copy to .env and edit for your machine. Never commit the populated .env.
# Workflow selection controls only the initial GUI mode; default remains explicit manual operation.
AICS_WORKFLOW_MODE=manual
AICS_WORKFLOW_LOG_LEVEL=INFO
# Enable generated visual prompts and other installed LLM features.
AICS_LLM_PROVIDER=openai
# Choose an explicit OpenAI API model supported by your account.
AICS_OPENAI_MODEL=
# Name of the environment variable holding the API key.
AICS_OPENAI_API_KEY_ENV=OPENAI_API_KEY
# Secret: set only in your ignored local .env.
OPENAI_API_KEY=

# Managed local image and final-resolution installations.
AICS_IMAGE_PROVIDER=local
AICS_LOCAL_IMAGE_ROOT="D:/AI Content Studio/local-image-d061"
AICS_UPSCALE_PROVIDER=local
AICS_LOCAL_UPSCALE_ROOT=D:/AI Content Studio/upscaler-d060

# Source-development Chatterbox launcher. Install runtimes separately.
AICS_CHATTERBOX_RUNTIME_ROOT=D:/Projects/ai-content-generation/.runtime/d029-managed-current
AICS_CHATTERBOX_MODEL_ROOT=D:/Projects/ai-content-generation/.runtime/d029-models
AICS_CHATTERBOX_CACHE_ROOT=D:/Projects/ai-content-generation/.runtime/desktop-chatterbox-test

# Optional LLM tuning; values shown are the current provider defaults.
AICS_OPENAI_TIMEOUT_SECONDS=60
AICS_OPENAI_MAX_OUTPUT_TOKENS=4096
AICS_OPENAI_MAX_RETRIES=2
AICS_OPENAI_REQUEST_INTERVAL_SECONDS=0
AICS_OPENAI_RETRY_DELAY_SECONDS=1

# Optional second generator: GPT Image 2. Local remains the default selection.
AICS_OPENAI_IMAGE_MODEL=gpt-image-2
AICS_OPENAI_IMAGE_QUALITY=low
AICS_OPENAI_IMAGE_BACKGROUND=auto
AICS_OPENAI_IMAGE_MODERATION=auto
AICS_OPENAI_IMAGE_OUTPUT_COMPRESSION=90
AICS_OPENAI_IMAGE_TIMEOUT_SECONDS=120
AICS_OPENAI_IMAGE_MAX_BYTES=16777216
AICS_OPENAI_IMAGE_MAX_RETRIES=2
AICS_OPENAI_IMAGE_REQUEST_INTERVAL_SECONDS=0
AICS_OPENAI_IMAGE_RETRY_DELAY_SECONDS=1
